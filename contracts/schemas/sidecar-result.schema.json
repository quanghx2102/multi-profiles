{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-profiles:schema:sidecar-result:1",
  "title": "Sidecar Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "requestId", "operationId", "outcome", "completedAt", "result", "error", "reconciliationHints"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "requestId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "outcome": { "enum": ["SUCCESS", "REJECTED_BEFORE_EFFECT", "FAILED_AFTER_PARTIAL_EFFECT", "OUTCOME_UNKNOWN"] },
    "completedAt": { "type": "string", "format": "date-time" },
    "result": { "type": ["object", "null"], "maxProperties": 128, "additionalProperties": true, "x-sensitive": false },
    "error": { "oneOf": [{ "$ref": "typed-error.schema.json" }, { "type": "null" }] },
    "processEvidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "sidecarSessionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "browserProcessId": { "type": "integer", "minimum": 1 },
        "ownershipEvidenceRef": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "reconciliationHints": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}

