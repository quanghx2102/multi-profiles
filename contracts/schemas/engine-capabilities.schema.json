{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-profiles:schema:engine-capabilities:1",
  "title": "Engine Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineId", "adapterVersion", "protocolVersions", "capabilities", "qualificationRef"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "engineId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
    "adapterVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "coreId": { "type": ["string", "null"], "maxLength": 256 },
    "protocolVersions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
    "capabilities": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "supported", "constraints"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,127}$" },
          "version": { "type": "string", "minLength": 1, "maxLength": 32 },
          "supported": { "type": "boolean" },
          "constraints": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": ["string", "number", "integer", "boolean", "array", "null"] } }
        }
      }
    },
    "qualificationRef": { "type": ["string", "null"], "maxLength": 512 }
  }
}

