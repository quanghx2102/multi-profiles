{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-profiles:schema:sidecar-request:1",
  "title": "Sidecar Request Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "requestId", "operationId", "correlationId", "kind", "deadlineUtc", "cancellationPolicy", "capabilityAssumptions", "references", "payload"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "requestId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "format": "uuid" },
    "profileId": { "type": ["string", "null"], "format": "uuid" },
    "kind": { "enum": ["REPORT_CAPABILITIES", "VALIDATE_CORE_CANDIDATE", "VALIDATE_INSTALLATION", "CREATE_IDENTITY", "VALIDATE_IDENTITY", "START_PROFILE", "STOP_PROFILE", "PROBE_FINGERPRINT", "VALIDATE_MIGRATION", "RECONCILE"] },
    "deadlineUtc": { "type": "string", "format": "date-time" },
    "cancellationPolicy": { "enum": ["NOT_CANCELLABLE", "COOPERATIVE", "COOPERATIVE_THEN_SUPERVISOR_ESCALATION"] },
    "capabilityAssumptions": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coreRef": { "type": ["string", "null"], "maxLength": 256 },
        "dataDirectoryRef": { "type": ["string", "null"], "maxLength": 256 },
        "identityManifestRef": { "type": ["string", "null"], "maxLength": 256 },
        "credentialRefs": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 8, "maxLength": 256, "x-sensitive": "reference-only" } }
      }
    },
    "payload": { "type": "object", "maxProperties": 128, "additionalProperties": true, "description": "Must be validated by a versioned operation-specific schema before implementation acceptance." }
  }
}

